# ---- Core ----
APP_NAME=Scholara
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
# Shared with frontend/.env.local. Exempts the website's own server-side rendering from
# the public rate limit so a production build is not throttled by its own API.
INTERNAL_API_TOKEN=dev-internal-render-token
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Database ----
# Dev (zero-config):
DATABASE_URL=sqlite:///./data/scholara.db
# Production (Render + Supabase): use the IPv4 Session Pooler, not the direct host.
# Supabase Dashboard -> Connect -> Session Pooler gives the host and the
# `postgres.<project-ref>` username. Percent-encode special characters in the password.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Optional pool/timeout tuning (defaults keep one web instance + worker inside a small pool):
# DB_CONNECT_TIMEOUT=10
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=180
# DB_SSLMODE=require            # only needed when the URL does not already carry sslmode

# ---------------------------------------------------------------- Redis
# Unset -> in-process cache (single node only). Set -> shared cache AND shared rate-limit
# counters, which is what makes limits correct across more than one worker.
# Production Upstash: use the TLS TCP endpoint (rediss://), never the REST URL.
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379/0
# REDIS_SOCKET_CONNECT_TIMEOUT=3
# REDIS_SOCKET_TIMEOUT=3
# CACHE_KEY_PREFIX=scholara:     # namespaces this app inside a shared Redis database

# ---------------------------------------------------------------- Celery
# Unset -> the scheduled jobs run on an in-process thread timer (development only).
# Set -> Celery owns the schedule; run a worker and beat alongside the API:
#   celery -A app.services.tasks:celery_app worker --pool=threads
#   celery -A app.services.tasks:celery_app beat
# Production Upstash: use the TLS TCP endpoint. Do not assume a /1 database exists.
# CELERY_BROKER_URL=rediss://default:<password>@<host>.upstash.io:6379/0
# Optional. Leave unset to ignore task results; set only if the plan supports another DB.
# CELERY_RESULT_BACKEND=
# In production, leave the web service's in-process scheduler off and run Celery beat.
# SCHEDULER_ENABLED=false

# ------------------------------------------------------------ Embeddings
# Dense retrieval for the assistant. With no key set, a deterministic local hashing
# vectoriser is used, so the pgvector path works unconfigured - it just has no semantic
# knowledge beyond token and trigram overlap. Set a key for real semantic matching.
# EMBEDDINGS_ENABLED=true
# EMBEDDING_DIM=1024              # changing this needs a new migration + full reindex
# MISTRAL_EMBED_MODEL=mistral-embed
# GEMINI_EMBED_MODEL=gemini-embedding-001
# RETRIEVAL_DENSE_WEIGHT=0.65     # dense vs lexical in the hybrid fusion
# RETRIEVAL_MIN_SCORE=0.10        # floor below which a vector-only match is discarded

# ---- CORS / hosts ----
CORS_ORIGINS=*
PUBLIC_SITE_URL=http://localhost:3000

# ---- Seeded admin account ----
ADMIN_EMAIL=admin@scholara.com.bd
ADMIN_PASSWORD=Admin@12345

# ---- WhatsApp Business Cloud API (Phase 7) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Meta / Facebook (Page + Ads + Conversions API) ----
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# ---- Google ----
GA4_MEASUREMENT_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_SITE_VERIFICATION=

# ---- LLM for the grounded assistant: Grok, Mistral or Gemini ----
# All three speak the OpenAI-compatible /chat/completions format, so they are interchangeable.
# Set ANY ONE of the keys below and the assistant switches from deterministic templates to
# generated answers. With none set it still works, just without generation.
#
# Providers are tried in LLM_PROVIDER_ORDER and the FIRST one that is configured and answers
# wins; if it errors, the next is tried automatically. Leave a key blank to skip that provider.
LLM_ENABLED=true
LLM_PROVIDER_ORDER=grok,mistral,gemini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.2

# Grok (xAI) - key from https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# Mistral AI - key from https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Gemini (Google AI Studio) - key from https://aistudio.google.com/apikey
# Note the /openai suffix: that is Google's OpenAI-compatibility endpoint, not the native one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model names move fast. If a call 404s on "model not found", check the provider's model list
# and override the *_MODEL value above - no code change is needed.
