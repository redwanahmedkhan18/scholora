# Scholara web (Next.js) - environment variables
#
# Copy to `.env.local` for local development. On Vercel, set these in
# Project -> Settings -> Environment Variables (Production and Preview).
#
# Nothing here is exposed to the browser. Only names starting with NEXT_PUBLIC_ are
# inlined into the client bundle, so never put a token, password or key in one.

# --------------------------------------------------------------------- backend origin
# Absolute origin of the FastAPI backend. Server components and the /api/:path* rewrite
# both use it. REQUIRED for `next build` and for every Vercel deployment: the build fails
# with a message naming this variable rather than publishing pages that fetched nothing.
# Production form:
INTERNAL_API_URL=https://scholora-cfch.onrender.com
# Local development (the default when the variable is unset in `next dev`):
# INTERNAL_API_URL=http://127.0.0.1:8000

# Set this only for a deliberate production-mode build against a local API, e.g.
# `ALLOW_LOCAL_API=true INTERNAL_API_URL=http://127.0.0.1:8000 npm run build`.
# Without it, a production build refuses a loopback backend.
# ALLOW_LOCAL_API=false

# -------------------------------------------------------------- build-time rate limiting
# Shared secret sent as X-Internal-Token on server-side rendering calls, so a build is not
# throttled by the backend's public rate limit (a 429 mid-build freezes wrong pages into
# the static output). Must match INTERNAL_API_TOKEN on the Render service. Server-side only.
# INTERNAL_API_TOKEN=dev-internal-render-token

# -------------------------------------------------------------------------- public origin
# Canonical site origin for metadata, Open Graph, robots.txt and sitemap.xml.
# On Vercel this can be omitted: the deployment's own domain is used automatically
# (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL). A canonical URL must never be localhost,
# so the build refuses to fall back to it in production.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# ------------------------------------------------------------------------- build tuning
# Static generation forks a worker per CPU. Capping it keeps a small build container from
# being OOM-killed; raise it on a larger machine.
# NEXT_BUILD_WORKERS=1
